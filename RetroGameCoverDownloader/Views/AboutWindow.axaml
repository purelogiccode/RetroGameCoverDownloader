<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroGameCoverDownloader.Views.AboutWindow"
        Title="About Retro Game Cover Downloader"
        Width="500" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="28">
        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Image Source="avares://RetroGameCoverDownloader/Assets/logo.png"
                   Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="Retro Game Cover Downloader" Classes="title"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="AppVersionTextBlock" Classes="muted"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="A utility for downloading game cover art from libretro-thumbnails GitHub repositories for your ROM collection."
                       Classes="muted" TextAlignment="Center" MaxWidth="410" Margin="0,8,0,0" />
            <TextBlock Text="Uses the GitHub API to fetch available systems and cover art."
                       Classes="muted" TextAlignment="Center" MaxWidth="410" />
            <TextBlock Text="Supports rate limit handling, retries, and cross-platform desktop builds."
                       Classes="muted" TextAlignment="Center" MaxWidth="410" />
            <Button Content="https://www.purelogiccode.com"
                    Classes="link" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Click="WebsiteButton_Click" />
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Classes="primary"
                HorizontalAlignment="Center" MinWidth="110" Margin="0,16,0,0"
                Click="CloseButton_Click" />
    </Grid>
</Window>
